<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ProductReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" >

    <parameter name="ProductID" class="java.lang.Long"/>
    <parameter name="ProductName" class="java.lang.String"/>
    <parameter name="Description" class="java.lang.String"/>
    <parameter name="Height" class="java.lang.Double"/>
    <parameter name="Width" class="java.lang.Double"/>
    <parameter name="Weight" class="java.lang.Double"/>
    <parameter name="StageName" class="java.lang.String"/>

    <!-- Parameters for the subreports -->
    <parameter name="MaterialsSubreport" class="java.io.InputStream"/>
    <parameter name="StageHistorySubreport" class="java.io.InputStream"/>
    <parameter name="MaterialsDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="StageHistoryDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>

    <queryString>
        <![CDATA[SELECT * FROM products WHERE id = $P{ProductID}]]>
    </queryString>

    <pageHeader>
        <band height="200">
            <staticText>
                <reportElement x="0" y="10" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Product Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="40" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isItalic="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[
                    "Generated on: "
                    + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())
                ]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="60" width="535" height="20"/>
                <textElement textAlignment="Left">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Product ID: " + $P{ProductID}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="80" width="535" height="20"/>
                <textFieldExpression><![CDATA["Name: " + $P{ProductName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="100" width="535" height="20"/>
                <textFieldExpression><![CDATA["Description: " + $P{Description}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="120" width="535" height="20"/>
                <textFieldExpression><![CDATA["Height: " + $P{Height} + " m"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="140" width="535" height="20"/>
                <textFieldExpression><![CDATA["Width: " + $P{Width} + " m"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="160" width="535" height="20"/>
                <textFieldExpression><![CDATA["Weight: " + $P{Weight} + " g"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="180" width="535" height="20"/>
                <textFieldExpression><![CDATA["Stage: " + $P{StageName}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="200">
            <subreport>
                <reportElement x="0" y="0" width="535" height="1"/>
                <dataSourceExpression><![CDATA[$P{MaterialsDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{MaterialsSubreport}]]></subreportExpression>
            </subreport>
            <break>
                <reportElement x="0" y="199" width="535" height="1"/>
            </break>
        </band>
        <band height="200">
            <subreport>
                <reportElement x="0" y="0" width="535" height="1"/>
                <dataSourceExpression><![CDATA[$P{StageHistoryDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{StageHistorySubreport}]]></subreportExpression>
            </subreport>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="400" y="0" width="60" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of "]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="460" y="0" width="40" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
