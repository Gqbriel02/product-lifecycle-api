<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="MaterialsSubreport" pageWidth="535" pageHeight="100" columnWidth="515"
              leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10">

    <field name="id.materialNumber" class="java.lang.String"/>
    <field name="material.materialDescription" class="java.lang.String"/>
    <field name="qty" class="java.lang.Double"/>
    <field name="unitMeasureCode" class="java.lang.String"/>


    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="110" y="0" width="200" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Material]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Quantity]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Unit]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{id.materialNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="110" y="0" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{material.materialDescription}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{unitMeasureCode}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
